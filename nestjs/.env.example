# Copy file này thành .env khi chạy local, hoặc khai báo từng biến này trong phần
# "Environment Variables" của Render.com (không upload file .env lên đó).

# Chuỗi kết nối MongoDB (Atlas hoặc tự host) — lấy từ .env hiện tại của bạn.
MONGODB_URI=

# Chuỗi bí mật ký JWT — chuỗi ngẫu nhiên dài, giữ nguyên giá trị hiện tại khi deploy
# (đổi giá trị sẽ làm mọi access token đang có bị vô hiệu, buộc user đăng nhập lại).
JWT_SECRET=

JWT_EXPIRES_IN=15m

# URL thật của frontend sau khi deploy (Vercel/Netlify...) — dùng để tạo link trong email
# (xác thực email, quên mật khẩu). Đổi lại sau khi có domain thật.
FRONTEND_URL=https://ten-app-cua-ban.vercel.app

# Gửi email (xác thực/quên mật khẩu) qua Resend (HTTPS API) — Render (Free) chặn cổng SMTP nên
# không dùng Gmail SMTP trực tiếp được nữa. Lấy API key tại resend.com (đăng ký bằng GitHub).
RESEND_API_KEY=

# Chưa xác minh domain riêng trên Resend thì để trống — code tự dùng địa chỉ mặc định của Resend
# (chỉ gửi được tới đúng email bạn đăng ký tài khoản Resend, đủ để demo/test).
RESEND_FROM=
